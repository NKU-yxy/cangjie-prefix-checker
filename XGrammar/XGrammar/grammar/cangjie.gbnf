# ============================================================
# Cangjie Programming Language - GBNF Grammar
# For XGrammar-based syntax checking
# Based on Cangjie Language Specification v0.53.x
#
# NOTE: Comments are stripped before grammar checking.
# Newlines (\n, \r) must be used as string literals, NOT inside
# character classes (GBNF limitation).
# ============================================================

# -----------------------------------------------------------
# 0. Whitespace (comments handled by preprocessor)
# -----------------------------------------------------------

# Single whitespace character (space, tab, or newline/cr as strings)
ws_char ::= [ \t] | "\n" | "\r"

# Optional whitespace
ws ::= ws_char*

# Required whitespace (at least one)
ws_req ::= ws_char+

# -----------------------------------------------------------
# 1. Lexical Elements
# -----------------------------------------------------------

# Identifiers
identifier ::= ident_start ident_continue*
ident_start ::= [a-zA-Z_]
ident_continue ::= [a-zA-Z0-9_]

# Raw identifier (backtick-quoted)
raw_identifier ::= "`" identifier "`"

# Any identifier (regular or raw)
any_identifier ::= identifier | raw_identifier

# Integer literals
decimal_digit ::= [0-9]
hex_digit ::= [0-9a-fA-F]
bin_digit ::= [01]
octal_digit ::= [0-7]

decimal_literal ::= "0" | [1-9] decimal_digit*
hex_literal ::= "0" [xX] hex_digit+
octal_literal ::= "0" [oO] octal_digit+
binary_literal ::= "0" [bB] bin_digit+

integer_suffix ::= "i8" | "i16" | "i32" | "i64" | "u8" | "u16" | "u32" | "u64"
integer_literal ::= (decimal_literal | hex_literal | octal_literal | binary_literal) integer_suffix?

# Float literals
float_suffix ::= "f16" | "f32" | "f64"
float_exp_part ::= [eE] [+\-]? decimal_digit+
float_literal_simple ::= decimal_digit+ "." decimal_digit* float_exp_part?
float_literal_exp ::= decimal_digit+ float_exp_part
float_literal ::= (float_literal_simple | float_literal_exp) float_suffix?

# Boolean literals
boolean_literal ::= "true" | "false"

# String literals (using hex escapes for special chars)
string_char_esc ::= "\\" [\\\"'ntrbfv0$] | "\\" "u" "{" hex_digit{1,8} "}"
string_char_safe ::= [^\"\\]
string_char ::= string_char_safe | string_char_esc
string_literal ::= "\"" string_char* "\""

# Multi-line string
ml_string_char ::= [^\\] | string_char_esc
multi_line_string ::= "\"\"\"" ml_string_char* "\"\"\""

# Rune literal
rune_char ::= [^'\\] | string_char_esc
rune_literal ::= "r" "'" rune_char "'"

# All literals
literal ::= float_literal | integer_literal | boolean_literal | string_literal | multi_line_string | rune_literal

# -----------------------------------------------------------
# 2. Types
# -----------------------------------------------------------

# Built-in primitive types
primitive_type ::= "Int8" | "Int16" | "Int32" | "Int64" | "IntNative"
                | "UInt8" | "UInt16" | "UInt32" | "UInt64" | "UIntNative"
                | "Float16" | "Float32" | "Float64"
                | "Bool" | "Rune" | "String" | "Unit" | "Nothing"

# Type reference (can be primitive or user-defined)
type_name ::= any_identifier ("." any_identifier)*

# Array type: Array<T> or T[]
array_type ::= "Array" ws "<" ws type ws ">" | type ws "[" ws "]"

# Function type: (T1, T2) -> TRet
func_type_param_list ::= type (ws "," ws type)*
func_type ::= "(" ws func_type_param_list? ws ")" ws "->" ws type

# Nullable type: T?
nullable_type ::= type ws "?"

# Tuple type
tuple_type ::= "(" ws type (ws "," ws type)+ ws ")"

# Any type expression
type ::= primitive_type | func_type | array_type | nullable_type | tuple_type | type_name

# -----------------------------------------------------------
# 3. Expressions
# -----------------------------------------------------------

# Primary expressions
primary ::= literal
         | any_identifier
         | "(" ws expression ws ")"
         | "this"
         | "super"
         | array_literal
         | tuple_literal
         | lambda_expression

# Array literal: [expr1, expr2, ...]
array_literal ::= "[" ws (expression (ws "," ws expression)*)? ws ","? ws "]"

# Tuple literal: (expr1, expr2, expr3)
tuple_expr_item ::= ws expression ws ","? ws
tuple_literal ::= "(" ws expression ws "," ws expression (ws "," ws expression)* ws ")"

# Lambda: { (params) => body }
lambda_param_list ::= any_identifier (ws "," ws any_identifier)*
lambda_expression ::= "{" ws lambda_param_list? ws "=>" ws expression ws "}"

# Struct/object init: { field1: val1, field2: val2, ... }
struct_init_field ::= any_identifier ws ":" ws expression
struct_init_fields ::= struct_init_field (ws "," ws struct_init_field)* ws ","?

# Postfix expressions
postfix_expr ::= primary (ws postfix_op)*
postfix_op ::= "." ws any_identifier
             | "(" ws argument_list? ws ")"
             | "[" ws expression ws "]"
             | ws "!"
             | ws "{" ws struct_init_fields ws "}"

# Argument list
argument_list ::= expression (ws "," ws expression)*

# Unary expressions
unary_expr ::= ("-" | "!" | "++" | "--") ws unary_expr | postfix_expr

# Binary expressions (in precedence order)
multiplicative_expr ::= unary_expr (ws ("*" | "/" | "%" | "**") ws unary_expr)*
additive_expr ::= multiplicative_expr (ws ("+" | "-") ws multiplicative_expr)*
shift_expr ::= additive_expr (ws ("<<" | ">>") ws additive_expr)*
range_expr ::= shift_expr (ws (".." | "..=") ws shift_expr)?
comparison_expr ::= range_expr (ws ("<=" | ">=" | "<" | ">") ws range_expr)*
type_check_expr ::= comparison_expr (ws ("is" | "as") ws type)?
equality_expr ::= type_check_expr (ws ("==" | "!=") ws type_check_expr)*
bitwise_and_expr ::= equality_expr (ws "&" ws equality_expr)*
bitwise_xor_expr ::= bitwise_and_expr (ws "^" ws bitwise_and_expr)*
bitwise_or_expr ::= bitwise_xor_expr (ws "|" ws bitwise_xor_expr)*
logical_and_expr ::= bitwise_or_expr (ws "&&" ws bitwise_or_expr)*
logical_or_expr ::= logical_and_expr (ws "||" ws logical_and_expr)*
coalescing_expr ::= logical_or_expr (ws "??" ws logical_or_expr)*
pipeline_expr ::= coalescing_expr (ws ("|>" | "~>") ws coalescing_expr)*

# Assignment expression (right-associative handled by optional)
assignment_op ::= "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "**=" | "<<=" | ">>=" | "&=" | "^=" | "|=" | "&&=" | "||="
assignment_expr ::= pipeline_expr (ws assignment_op ws assignment_expr)?

# Full expression
expression ::= assignment_expr

# -----------------------------------------------------------
# 4. Statements
# -----------------------------------------------------------

# Expression statement
expr_stmt ::= expression ws ";"?

# Variable declaration
var_decl ::= ("var" | "let") ws_req any_identifier (ws ":" ws type)? (ws "=" ws expression)? ws ";"?

# Assignment statement (non-declaration)
assign_stmt ::= expression ws assignment_op ws expression ws ";"?

# Block statement (recursive to avoid nested-brace ambiguity with *)
block ::= "{" ws statements ws "}"
statements ::= statement (ws statements)?

# If statement
if_stmt ::= "if" ws_req expression ws block (ws "else" ws (block | if_stmt))?

# While statement
while_stmt ::= "while" ws_req expression ws block

# For statement
for_stmt ::= "for" ws_req "(" ws any_identifier ws "in" ws expression ws ")" ws block

# Do-while statement
do_while_stmt ::= "do" ws block ws "while" ws_req expression ws ";"?

# Break/continue
break_stmt ::= "break" ws ";"?
continue_stmt ::= "continue" ws ";"?

# Return statement
return_stmt ::= "return" (ws_req expression)? ws ";"?

# Throw statement
throw_stmt ::= "throw" ws_req expression ws ";"?

# Try-catch-finally
catch_clause ::= ws "catch" ws "(" ws any_identifier (ws ":" ws type)? ws ")" ws block
finally_clause ::= ws "finally" ws block
try_stmt ::= "try" ws block catch_clause? finally_clause?

# Match statement
match_case ::= "case" ws_req pattern ws "=>" ws (expression | block)
match_case_list ::= match_case (ws "," ws match_case)* ws ","?
match_stmt ::= "match" ws_req "(" ws expression ws ")" ws "{" ws match_case_list ws "}"

# Pattern (simplified)
pattern ::= literal | any_identifier | "_"

# All statements
statement ::= var_decl
           | assign_stmt
           | if_stmt
           | while_stmt
           | for_stmt
           | do_while_stmt
           | break_stmt
           | continue_stmt
           | return_stmt
           | throw_stmt
           | try_stmt
           | match_stmt
           | expr_stmt
           | block

# -----------------------------------------------------------
# 5. Declarations
# -----------------------------------------------------------

# Function parameter
func_param ::= any_identifier ws ":" ws type (ws "=" ws expression)?

# Function parameter list
func_param_list ::= func_param (ws "," ws func_param)*

# Function declaration
func_decl ::= "func" ws_req any_identifier ws "(" ws func_param_list? ws ")" ws (":" ws type)? ws block

# Field declaration
field_decl ::= any_identifier ws ":" ws type (ws "=" ws expression)? ws ";"?

# Class member
class_member ::= field_decl | func_decl

# Class members (recursive)
class_members ::= class_member (ws class_members)?

# Class declaration
class_parents ::= ws ":" ws type (ws "," ws type)*
class_decl ::= "class" ws_req any_identifier class_parents? ws "{" ws class_members ws "}"

# Fields (recursive)
fields ::= field_decl (ws fields)?

# Struct declaration
struct_decl ::= "struct" ws_req any_identifier class_parents? ws "{" ws fields ws "}"

# Enum case
enum_case ::= any_identifier (ws "=" ws expression)?

# Enum declaration
enum_decl ::= "enum" ws_req any_identifier (ws ":" ws type)? ws "{" ws enum_case (ws "," ws enum_case)* ws ","? ws "}"

# Interface method (signature without body)
interface_method ::= "func" ws_req any_identifier ws "(" ws func_param_list? ws ")" ws (":" ws type)? ws ";"?

# Interface members (recursive)
interface_methods ::= interface_method (ws interface_methods)?

# Interface declaration
interface_decl ::= "interface" ws_req any_identifier class_parents? ws "{" ws interface_methods ws "}"

# Extension declaration
extend_decl ::= "extend" ws_req type class_parents? ws "{" ws class_members ws "}"

# Operator overload
operator_decl ::= "operator" ws_req "(" ws operator_token ws ")" ws "(" ws func_param_list? ws ")" ws (":" ws type)? ws block
operator_token ::= "+" | "-" | "*" | "/" | "%" | "**" | "==" | "!=" | "<" | ">" | "<=" | ">=" | "[]" | "()"

# Main entry point (can omit "func" keyword)
main_decl ::= "main" ws "(" ws func_param_list? ws ")" ws block

# All declarations
declaration ::= func_decl
             | main_decl
             | class_decl
             | struct_decl
             | enum_decl
             | interface_decl
             | extend_decl
             | operator_decl
             | var_decl

# -----------------------------------------------------------
# 6. Program Structure
# -----------------------------------------------------------

# Package declaration
package_name ::= any_identifier ("." any_identifier)*
package_decl ::= "package" ws_req package_name ws ";"?

# Import declaration
import_single ::= package_name
import_alias ::= package_name ws "as" ws_req any_identifier
import_all ::= package_name ws "." ws "*"
import_decl ::= "import" ws_req (import_all | import_alias | import_single) ws ";"?

# Top-level item
top_level_item ::= package_decl | import_decl | declaration

# Root: the entire program
root ::= ws top_level_item (ws top_level_item)* ws
