// Vendored from the competition reference implementation:
// https://gitcode.com/bhzhan/cangjie-fragment-checker
// Not claimed as team-original code; provenance and adaptations are documented
// in ../README.md and the repository-level THIRD_PARTY_NOTICES.md.

// Lark grammar aligned to samples/cangjie_contest_subset.bnf (contest Appendix A + corpus extensions).
// Parser: LALR (expression grammar avoids ambiguous generic-vs-relational parses).

%import common.WS
%ignore WS
%ignore /\/\/[^\n]*/

// --- Keyword terminals (higher priority than IDENT) ---
// Suffix `(?![A-Za-z0-9_])` avoids prefix-steal (e.g. `in` vs `inc`, `class` vs `classTag`, `Array` vs `ArrayList`).
FUNC.12: /func(?![A-Za-z0-9_])/
LET.12: /let(?![A-Za-z0-9_])/
VAR.12: /var(?![A-Za-z0-9_])/
_IF.12: /if(?![A-Za-z0-9_])/
_ELSE.12: /else(?![A-Za-z0-9_])/
_WHILE.12: /while(?![A-Za-z0-9_])/
_FOR.12: /for(?![A-Za-z0-9_])/
_IN.12: /in(?![A-Za-z0-9_])/
RETURN.12: /return(?![A-Za-z0-9_])/
BREAK.12: /break(?![A-Za-z0-9_])/
CONTINUE.12: /continue(?![A-Za-z0-9_])/
PUBLIC.12: /public(?![A-Za-z0-9_])/
PRIVATE.12: /private(?![A-Za-z0-9_])/
STATIC.12: /static(?![A-Za-z0-9_])/
CLASS.12: /class(?![A-Za-z0-9_])/
INTERFACE.12: /interface(?![A-Za-z0-9_])/
INIT.12: /init(?![A-Za-z0-9_])/
TRUE.12: /true(?![A-Za-z0-9_])/
FALSE.12: /false(?![A-Za-z0-9_])/
INT64.12: /Int64(?![A-Za-z0-9_])/
FLOAT64.12: /Float64(?![A-Za-z0-9_])/
BOOL.12: /Bool(?![A-Za-z0-9_])/
RUNE.12: /Rune(?![A-Za-z0-9_])/
UNIT.12: /Unit(?![A-Za-z0-9_])/
MAIN.12: /main(?![A-Za-z0-9_])/

DOTDOTEQ: "..="
// `..` but not the first two characters of `..=`
DOTDOT: /\.\.(?!=)/
_SUBTYPE: "<:"
ARROW: "->"
// Named operator / bracket terminals so they appear in parse trees (needed for type checking).
LESSTHAN: "<"
MORETHAN: ">"
// Generic type-argument opener in expression position, only when the RHS looks type-like.
// This avoids LALR committing `x < 0` to a generic-argument parse.
_GEN_LT: /<(?=\s*(?:Int64|Float64|Bool|Rune|[A-Z_]|\())/
PLUS: "+"
MINUS: "-"
STAR: "*"
SLASH: "/"
PERCENT: "%"
OROR: "||"
ANDAND: "&&"
EQEQ: "=="
EQ: "="
NE: "!="
LE: "<="
GE: ">="

// Named bracket terminals so they appear in parse trees (anonymous open-paren tokens are dropped).
LPAR: "("
RPAR: ")"

LBRACE: "{"
RBRACE: "}"
COMMA: ","
DOT: "."
LBRACK: "["
RBRACK: "]"

// Priority 12 keywords vs 11 IDENT (see README for `in` / `main` handling).
IDENT.11: /[A-Za-z_][A-Za-z0-9_]*/

INTEGER: /[0-9][0-9_]*L?/
FLOAT: /[0-9][0-9_]*\.[0-9_]+([eE][+-]?[0-9_]+)?/

// Single-token string literals (avoids IDENT stealing text inside `"..."`).
STRING: /"(?:\\.|[^"\\])*"/

// --- Program (BNF §0 + corpus extensions) ---
?start: program

program: file_item*

?file_item: function_definition
         | class_definition
         | interface_declaration

// --- Declarations (locals require explicit type per Article 5) ---
variable_declaration: (LET | VAR) IDENT type_annotation "=" expression

// --- Types ---
// Parenthesized types: optional func_suffix disambiguates `(A, B) -> R` from `(A, B)`.
?type: paren_type_form
     | simple_type

paren_type_form: "(" [type ("," type)*] ")" func_suffix

func_suffix: "->" type
            |

?simple_type: primitive_type
            | IDENT [type_arguments]

primitive_type: INT64 | FLOAT64 | BOOL | RUNE | UNIT

type_arguments: "<" type ("," type)* ">"

type_parameters: "<" IDENT ("," IDENT)* ">"

type_list: type ("&" type)*

// --- Top-level functions ---
function_definition: function_header block_expression
                   | main_header block_expression

function_header: function_lead function_name opt_type_parameters function_params ret_clause
function_lead: [visibility] [STATIC] FUNC
function_name: IDENT
function_params: param_clause

main_header: main_lead ret_clause
main_lead: MAIN "(" ")"

visibility: PUBLIC | PRIVATE

parameter_list: parameter ("," parameter)*

?parameter: typed_parameter

typed_parameter: IDENT ["!"] type_annotation [default_value]

default_value: "=" expression

param_clause: "(" opt_parameter_list ")"
opt_parameter_list: parameter_list?

ret_clause: type_annotation
type_annotation: ":" type

// --- Class (Appendix + corpus: let/var fields, constructors) ---
class_definition: class_lead class_name opt_type_parameters opt_class_subtype_clause class_body
class_lead: [PUBLIC] CLASS
class_name: IDENT
class_subtype_clause: _SUBTYPE type ["&" type_list]
opt_class_subtype_clause: class_subtype_clause?

class_body: LBRACE class_member* RBRACE
class_member: class_field_member
            | class_method_member
            | class_constructor_member
class_field_member: field_let_decl
class_method_member: method_definition
class_constructor_member: constructor_definition

field_let_decl: field_lead typed_name [default_value]
field_lead: [visibility] [STATIC] (LET | VAR)

method_definition: method_header block_expression

constructor_definition: constructor_lead constructor_params constructor_body
constructor_lead: [visibility] INIT
constructor_params: param_clause
constructor_body: block_expression

// --- Interface ---
interface_declaration: interface_lead interface_name opt_type_parameters opt_interface_subtype_clause interface_body
interface_lead: [PUBLIC] INTERFACE
interface_name: IDENT
interface_subtype_clause: _SUBTYPE type_list
opt_interface_subtype_clause: interface_subtype_clause?

interface_body: LBRACE abstract_method* RBRACE

abstract_method: abstract_method_lead method_name opt_type_parameters method_params ret_clause
abstract_method_lead: FUNC

method_header: method_lead method_name opt_type_parameters method_params ret_clause
method_lead: [visibility] [STATIC] FUNC
method_name: IDENT
method_params: param_clause

opt_type_parameters: type_parameters?

typed_name: IDENT type_annotation

// --- Blocks ---
block_expression: "{" block_element* "}"

?block_element: variable_declaration
               | expression

// --- Control (expressions in Appendix A) ---
if_expression: _IF "(" expression ")" block_expression [_ELSE (block_expression | if_expression)]

while_expression: _WHILE "(" expression ")" block_expression

// Appendix A: `for ( identifier in expression )` | `for ( identifier in range_expression )` only.
for_expression: _FOR "(" IDENT _IN for_iterable ")" block_expression

?for_iterable: expression
             | range_expression

range_expression: expression (DOTDOT | DOTDOTEQ) expression [":" expression]

// --- Lambda ---
lambda_expression: "{" [lambda_parameters] "=>" lambda_body "}"

lambda_parameters: lambda_param (COMMA lambda_param)*

lambda_param: IDENT [type_annotation]

?lambda_body: expression


// --- Expressions (LALR-friendly; left-associative via `a (op a)*` chains) ---
?expression: assign_expression

?assign_expression: logic_or_expr
                  | postfix_chain EQ assign_expression

?logic_or_expr: logic_and_expr (OROR logic_and_expr)*

?logic_and_expr: equality_expr (ANDAND equality_expr)*

?equality_expr: relational_expr ((EQEQ | NE) relational_expr)*

?relational_expr: additive_expr ((LESSTHAN | MORETHAN | LE | GE) additive_expr)*

?additive_expr: multiplicative_expr ((PLUS | MINUS) multiplicative_expr)*

?multiplicative_expr: unary_expr ((STAR | SLASH | PERCENT) unary_expr)*

?unary_expr: postfix_chain
           | "!" unary_expr
           | MINUS unary_expr

// Postfix / generic / call chain (no left recursion).
?postfix_chain: primary_expression (atom_suffix)*

atom_suffix: member_suffix
           | index_suffix
           | call_suffix
           | expr_type_arguments

member_suffix: "." IDENT [expr_type_arguments] [call_suffix]

index_suffix: "[" expression "]"

call_suffix: "(" [argument_list] ")"

expr_type_arguments: _GEN_LT type ("," type)* ">"

?primary_expression: literal
                   | name_expression
                   | "(" expression ")"
                   | tuple_literal
                   | array_literal
                   | block_expression
                   | if_expression
                   | while_expression
                   | for_expression
                   | lambda_expression
                   | break_expression
                   | continue_expression
                   | return_expression
                   | string_literal

name_expression: IDENT
string_literal: STRING

break_expression: BREAK
continue_expression: CONTINUE
return_expression: RETURN [expression]

// Tuple literals only (at least one comma). Avoids ambiguity with calls `f(a, b)` where
// `(` … `)` is an `atom_suffix` on a postfix chain.
tuple_literal: "(" expression ("," expression)+ ")"

array_literal: "[" [expression ("," expression)*] "]"

argument_list: argument ("," argument)*

?argument: expression
         | named_argument

named_argument: IDENT ":" expression

literal: number
       | TRUE
       | FALSE

number: FLOAT
      | INTEGER
