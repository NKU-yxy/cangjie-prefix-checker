{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:g4-029:portable-evidence-inventory:v1",
  "title": "G4-029 portable evidence inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bundle_id",
    "inventory_generated_from_frozen_inputs_at",
    "durable_repo_path",
    "candidate",
    "control",
    "release",
    "evidence",
    "artifacts",
    "source_closure",
    "external_dependencies",
    "path_policy",
    "exclusions",
    "determinism"
  ],
  "properties": {
    "schema": {"const": "g4-029-portable-evidence-inventory-v1"},
    "bundle_id": {"const": "g4-029-identifier-independent-acceptance"},
    "inventory_generated_from_frozen_inputs_at": {"type": "string"},
    "durable_repo_path": {"type": "string", "minLength": 1},
    "candidate": {"$ref": "#/$defs/revision"},
    "control": {"$ref": "#/$defs/revision"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sealed", "blockers", "policy"],
      "properties": {
        "sealed": {"type": "boolean"},
        "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "policy": {"type": "string"}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "source_closure": {
      "type": "object",
      "required": ["policy", "files", "full_diff"],
      "properties": {
        "policy": {"type": "string"},
        "files": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "full_diff": {"$ref": "#/$defs/artifact"}
      }
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "content_included", "verification_scope", "recursive_manifest_sha256"],
        "properties": {
          "id": {"type": "string"},
          "content_included": {"const": false},
          "verification_scope": {"const": "provenance_manifest_only"},
          "recursive_manifest_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "path_policy": {"type": "object"},
    "exclusions": {"type": "array", "items": {"type": "object"}},
    "determinism": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {
      "type": "object",
      "required": ["commit", "tree", "production_elf_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "cpp_solution_sha256": {"$ref": "#/$defs/sha256"},
        "production_elf_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "required": ["archive_path", "sha256", "size_bytes"],
      "properties": {
        "archive_path": {"type": "string", "pattern": "^[^/].*"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "treeBinding": {
      "type": "object",
      "required": ["algorithm", "file_count", "total_file_bytes", "sha256"],
      "properties": {
        "algorithm": {"type": "string"},
        "file_count": {"type": "integer", "minimum": 0},
        "total_file_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "id", "title", "tier", "status", "may_contribute",
        "required_for_final", "included", "source_locator", "archive_path",
        "internal_manifest", "claim_checks"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "tier": {"enum": ["formal", "supplemental"]},
        "status": {"enum": ["pass", "invalid", "pending", "pass_pre_gate"]},
        "may_contribute": {"type": "boolean"},
        "required_for_final": {"type": "boolean"},
        "included": {"type": "boolean"},
        "source_locator": {"type": ["string", "null"]},
        "archive_path": {"type": ["string", "null"]},
        "reason": {"type": "string"},
        "tree_binding": {"$ref": "#/$defs/treeBinding"},
        "internal_manifest": {"type": ["object", "null"]},
        "claim_checks": {"type": "array", "items": {"type": "object"}}
      },
      "allOf": [
        {
          "if": {"properties": {"may_contribute": {"const": true}}},
          "then": {
            "properties": {
              "tier": {"const": "formal"},
              "status": {"const": "pass"},
              "included": {"const": true}
            }
          }
        },
        {
          "if": {"properties": {"included": {"const": true}}},
          "then": {"required": ["tree_binding"]}
        }
      ]
    }
  }
}
